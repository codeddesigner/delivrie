{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/billing/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/billing/:path*"
    },
    {
      "source": "/api/events",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/automations/events"
    },
    {
      "source": "/api/automations/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/automations/:path*"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/oauth/metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/oauth/resource"
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/public/openai-apps-challenge"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/oauth/resource"
    },
    {
      "source": "/api/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/:path*"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/:page(terms|privacy|dpa|acceptable-use|cookies|subprocessors|security|about|customers|careers|brand|changelog|blog|status|contact-sales|support)",
      "destination": "/pages/:page.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/pages/blog/:slug.html"
    },
    {
      "source": "/media/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/storage/v1/object/public/email-assets/:path*"
    },
    {
      "source": "/(inbox|automations|events|login|signup|reset|confirm|verify|mfa|new-team|unsubscribe|docs|onboarding|emails|broadcasts|templates|contacts|segments|metrics|logs|domains|api-keys|webhooks|suppressions|billing|settings|profile|help|admin)",
      "destination": "/app.html"
    },
    {
      "source": "/(inbox|automations|events|docs|reset|invite|share|emails|broadcasts|templates|contacts|segments|logs|domains|webhooks|billing|settings|admin|oauth)/:rest*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}