{
  "name": "n8n-nodes-delivrie",
  "version": "1.0.0",
  "description": "Delivrie for n8n: send email, manage contacts and segments, start automations, reply in the Inbox, and trigger workflows from delivery events and received mail.",
  "keywords": ["n8n-community-node-package", "delivrie", "email", "transactional-email"],
  "license": "MIT",
  "homepage": "https://delivrie.io/docs/n8n",
  "author": { "name": "Surce Inc", "email": "support@delivrie.io" },
  "repository": { "type": "git", "url": "git+https://github.com/bysurce/delivrie.git", "directory": "integrations/n8n" },
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/Delivrie/delivrie.svg dist/nodes/Delivrie/",
    "prepublishOnly": "npm run build"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/DelivrieApi.credentials.js"],
    "nodes": ["dist/nodes/Delivrie/Delivrie.node.js", "dist/nodes/Delivrie/DelivrieTrigger.node.js"]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
